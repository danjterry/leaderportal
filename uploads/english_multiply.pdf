      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Multiply</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Francis Chan</rdf:li>
               <rdf:li>Mark Beuving</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Multiply is not just a book. It is a movement. Each of the twenty-four sessions in the book corresponds with an online video at www.multiplymovement.com featuring Francis Chan with New York Times bestselling author David Platt. Every copy of Multiply is designed to do what Jesus did: make disciples who make disciples who make disciples‚Ä¶. Until the world knows the truth of Jesus Christ.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Discipleship</rdf:li>
            </rdf:Bag>
         </dc:subject>
